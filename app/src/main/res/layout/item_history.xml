<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/color_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- LEFT: result badge -->
        <TextView
            android:id="@+id/tv_hist_overall"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="–"
            android:background="@drawable/badge_round"
            android:layout_marginEnd="12dp" />

        <!-- MIDDLE: measurements -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_hist_od"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/color_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="OD –" />

                <TextView
                    android:id="@+id/tv_hist_id"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/color_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="ID –" />

                <TextView
                    android:id="@+id/tv_hist_ht"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/color_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="HT –" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_hist_part"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/color_muted"
                    android:textSize="11sp"
                    android:text="TRF-001" />

                <TextView
                    android:id="@+id/tv_hist_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_muted"
                    android:textSize="11sp"
                    android:text="dd/MM/yy HH:mm" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
